# Server
PORT=5000
NODE_ENV=development

# Database — leave MONGO_URI empty to auto-start an in-memory MongoDB (great for demos).
# For a real DB use e.g. mongodb://127.0.0.1:27017/foodspot or an Atlas connection string.
MONGO_URI=

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — the frontend origin
CLIENT_URL=http://localhost:5173

# Cloudinary (optional — only needed for real image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
